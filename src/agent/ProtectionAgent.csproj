<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PurviewProtectionAgent</AssemblyName>
    <RootNamespace>PurviewProtectionOverlay.Agent</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Community contributors</Authors>
    <Description>Background protection-status cache for the Purview Protection Overlay.</Description>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.InformationProtection.File" Version="1.18.124" />
  </ItemGroup>
</Project>
